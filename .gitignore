# ============================================================
# 비밀 정보 / 인증 파일 (절대 커밋 금지)
# ============================================================
# dbt 접속 프로필 (예시 파일 profiles.yml.example 만 커밋)
profiles.yml
**/profiles.yml

# GCP 서비스 계정 키 등 JSON 인증 파일
*.json
# 단, 인증과 무관한 일반 JSON이 필요하면 아래처럼 예외 추가
# !path/to/safe_file.json

# 기타 키/인증서
*.pem
*.key
*.p12
*.pfx
*credentials*
*service_account*
*service-account*
.gcloud/

# 환경 변수 파일
.env
.env.*
!.env.example

# Superset 로컬 오버라이드 (비밀 키를 넣을 경우)
superset_config.py
docker-compose.override.yml

# ============================================================
# dbt 산출물
# ============================================================
target/
dbt_packages/
dbt_modules/
logs/
*.log
.user.yml

# ============================================================
# 데이터 파일 (원본 CSV는 저장소에 올리지 않음)
# ============================================================
*.csv
kpi_data/

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# ============================================================
# OS / 에디터
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
